# Supabase Public & Anon Keys (Dapat diperoleh dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Hanya untuk server side / migrasi rahasia, jangan diexpose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Website General Settings
NEXT_PUBLIC_SITE_NAME="Portal Berita Indonesia"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
